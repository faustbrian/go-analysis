        ],
        "package_selection": {
          "github.com/faustbrian/go-analysis/analysis": "Load strict repository policy and produce bounded JSON or SARIF reports.",
          "github.com/faustbrian/go-analysis/analyzers/backenderror": "Enforce translation of backend-specific errors at semantic boundaries.",
          "github.com/faustbrian/go-analysis/analyzers/blockingcontext": "Require context propagation for configured blocking operations.",
          "github.com/faustbrian/go-analysis/analyzers/cleanupownership": "Enforce explicit cleanup ownership for acquired resources.",
          "github.com/faustbrian/go-analysis/analyzers/constructorgoroutine": "Reject hidden goroutine startup during construction.",
          "github.com/faustbrian/go-analysis/analyzers/forbiddenapi": "Enforce reviewed forbidden-API policy.",
          "github.com/faustbrian/go-analysis/analyzers/globalgoroutine": "Reject goroutines started by package-global initialization.",
          "github.com/faustbrian/go-analysis/analyzers/goroutinefanout": "Enforce configured bounds on goroutine fan-out.",
          "github.com/faustbrian/go-analysis/analyzers/httpclienttimeout": "Require bounded HTTP client timeout policy.",
          "github.com/faustbrian/go-analysis/analyzers/importboundary": "Enforce declared package and architecture import boundaries.",
          "github.com/faustbrian/go-analysis/analyzers/interfacenaming": "Enforce configured interface role naming.",
          "github.com/faustbrian/go-analysis/analyzers/interfaceplacement": "Enforce consumer-owned interface placement.",
          "github.com/faustbrian/go-analysis/analyzers/lockacrosscall": "Detect locks retained across caller or blocking calls.",
          "github.com/faustbrian/go-analysis/analyzers/metriccardinality": "Enforce bounded metric-label cardinality.",
          "github.com/faustbrian/go-analysis/analyzers/mutableglobal": "Reject unreviewed mutable package-global state.",
          "github.com/faustbrian/go-analysis/analyzers/nobackground": "Reject unreviewed background-context detachment.",
          "github.com/faustbrian/go-analysis/analyzers/nodefaulthttp": "Reject direct use of default HTTP clients and transports.",
          "github.com/faustbrian/go-analysis/analyzers/noinit": "Reject package initialization functions where policy forbids them.",
          "github.com/faustbrian/go-analysis/analyzers/noprocesscontrol": "Reject application process-control calls outside approved boundaries.",
          "github.com/faustbrian/go-analysis/analyzers/nostoredcontext": "Reject contexts retained in long-lived state.",
          "github.com/faustbrian/go-analysis/analyzers/nounsafe": "Reject unreviewed unsafe package usage.",
          "github.com/faustbrian/go-analysis/analyzers/sensitivesink": "Detect sensitive values passed to configured disclosure sinks.",
          "github.com/faustbrian/go-analysis/analyzers/transactionrollback": "Require explicit transaction rollback ownership.",
          "github.com/faustbrian/go-analysis/cmd/golib-analysis": "Install the governed analyzer command for repository checks and reports.",
          "github.com/faustbrian/go-analysis/policy": "Inspect the stable built-in rule registry and governance metadata."
        },
